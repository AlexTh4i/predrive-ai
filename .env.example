# =====================================================================
# PreDrive AI — Production / Pilot Environment Template (.env.example)
# Copy to `.env` and set real secrets on server; NEVER commit `.env` (R4).
# =====================================================================

ENV=production
DOMAIN=predrive.example.com
CORS_ORIGINS=https://predrive.example.com

# --- Database (Supabase PostgreSQL 15 Session Pooler / Direct SSL) ---
DATABASE_URL=postgresql+psycopg://postgres.zpbskfqabxdhpdphqnjo:<DB_PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=

# --- Redis (Multi-instance SSE Pub/Sub & Sliding-window Rate Limit) ---
REDIS_URL=redis://redis:6379/0

# --- JWT & Security (Generate >= 32 random bytes: openssl rand -hex 32) ---
PREDRIVE_JWT_SECRET=<REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS>
PREDRIVE_JWT_ALGORITHM=HS256
PREDRIVE_JWT_EXPIRE_MINUTES=15
PREDRIVE_REFRESH_EXPIRE_DAYS=30
PREDRIVE_AUTO_SEED=0
PREDRIVE_ENABLE_LEGACY_AI=0
PREDRIVE_ENABLE_WATCHDOG=1
PREDRIVE_WATCHDOG_INTERVAL_SEC=5

# --- Observability (Prometheus / Grafana / Sentry) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<REPLACE_WITH_STRONG_GRAFANA_PASSWORD>
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Offsite Backup (`scripts/backup.sh`) ---
BACKUP_DIR=/var/backups/predrive
BACKUP_RETENTION_DAYS=14
BACKUP_S3_URI=
BACKUP_RCLONE_DEST=

# --- Push Notifications (Firebase Cloud Messaging - P3-7) ---
FCM_SERVER_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
VITE_FCM_VAPID_KEY=

# --- Automated Zalo OA / ZNS & SMS Fallback (P3-9) ---
ZALO_OA_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_ID=predrive_alert
SMS_API_URL=
SMS_API_KEY=

# --- Risk Score Weights & Reports Storage (P3-6) ---
PREDRIVE_REPORTS_DIR=/app/data/reports
RISK_WEIGHT_CRITICAL=25.0
RISK_WEIGHT_DROWSY=12.0
RISK_WEIGHT_DISTRACTION=6.0
RISK_WEIGHT_OVERTIME=10.0
RISK_SHIFT_HOURS_NORM=8.0

# --- Outbound Webhooks (P3-8) ---
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_BACKOFF_BASE_SEC=0.5
WEBHOOK_TIMEOUT_SEC=4.0
