# Local development only. Set explicit values before exposing the service.
PREDRIVE_ENV=development
PREDRIVE_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173

# --- Database (SQLite WAL by default; switch to PostgreSQL via DATABASE_URL) ---
DATABASE_URL=sqlite:///predrive.db
# Example PostgreSQL URL:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/predrive

# --- JWT & Security (M3) ---
PREDRIVE_JWT_SECRET=change-this-secret-in-production-at-least-32-chars
PREDRIVE_JWT_ALGORITHM=HS256
PREDRIVE_JWT_EXPIRE_MINUTES=1440

# --- Telemetry Retention & Watchdog (M3) ---
PREDRIVE_HEARTBEAT_RETENTION_DAYS=7
PREDRIVE_WATCHDOG_INTERVAL_SEC=5
PREDRIVE_ENABLE_WATCHDOG=1
PREDRIVE_AUTO_SEED=1

# --- Legacy M1/M2 WebSocket Gateway ---
PREDRIVE_MAX_FRAME_BYTES=2097152
PREDRIVE_MAX_IMAGE_WIDTH=1920
PREDRIVE_MAX_IMAGE_HEIGHT=1080
PREDRIVE_MAX_FPS=10
PREDRIVE_MAX_CONNECTIONS=20
PREDRIVE_MAX_SESSIONS=100
PREDRIVE_MAX_FRAME_AGE_SECONDS=60
PREDRIVE_MAX_FUTURE_SKEW_SECONDS=60
PREDRIVE_SESSION_TTL_SECONDS=3600
