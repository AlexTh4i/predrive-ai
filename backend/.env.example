# Local development only. Set explicit values before exposing the service.
ENV=development
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4174,http://127.0.0.1:4174,https://localhost,http://localhost,capacitor://localhost

# --- Database (SQLite WAL by default; switch to PostgreSQL / Supabase via DATABASE_URL) ---
DATABASE_URL=sqlite:///predrive.db
# Example Local PostgreSQL 15 URL:
# DATABASE_URL=postgresql+psycopg://predrive:predrive_local_dev@127.0.0.1:5432/predrive
# Example Supabase Session Pooler URL (IPv4 compatible, sslmode=require auto-added):
# DATABASE_URL=postgresql://postgres.zpbskfqabxdhpdphqnjo:<PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

PREDRIVE_DB_POOL_SIZE=5
PREDRIVE_DB_MAX_OVERFLOW=10
PREDRIVE_DB_POOL_RECYCLE=300

# --- Redis (Optional: used for distributed SSE Pub/Sub & Rate Limiting) ---
# REDIS_URL=redis://localhost:6379/0

# --- Observability (Optional: Sentry) ---
# SENTRY_DSN=

# --- JWT & Security ---
PREDRIVE_JWT_SECRET=change-this-secret-in-production-at-least-32-chars
PREDRIVE_JWT_ALGORITHM=HS256
PREDRIVE_JWT_EXPIRE_MINUTES=15
PREDRIVE_REFRESH_EXPIRE_DAYS=30

# --- Telemetry Retention & Watchdog ---
PREDRIVE_HEARTBEAT_RETENTION_DAYS=30
PREDRIVE_WATCHDOG_INTERVAL_SEC=5
PREDRIVE_ENABLE_WATCHDOG=1
PREDRIVE_AUTO_SEED=1

# --- Legacy M1/M2 WebSocket Gateway ---
PREDRIVE_MAX_FRAME_BYTES=2097152
PREDRIVE_MAX_IMAGE_WIDTH=1920
PREDRIVE_MAX_IMAGE_HEIGHT=1080
PREDRIVE_MAX_FPS=10
PREDRIVE_MAX_CONNECTIONS=20
PREDRIVE_MAX_SESSIONS=100
PREDRIVE_MAX_FRAME_AGE_SECONDS=60
PREDRIVE_MAX_FUTURE_SKEW_SECONDS=60
PREDRIVE_SESSION_TTL_SECONDS=3600
